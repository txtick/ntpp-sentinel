{
    log {
        format console
    }
}

:8030 {
    encode zstd gzip

    log {
        format console
    }

    handle /auth/* {
        reverse_proxy web-backend:8020
    }

    handle /api/* {
        reverse_proxy web-backend:8020
    }

    handle {
        root * /usr/share/caddy
        header /index.html Cache-Control "no-store, no-cache, must-revalidate"
        header /app.js Cache-Control "no-store, no-cache, must-revalidate"
        header /styles.css Cache-Control "no-store, no-cache, must-revalidate"
        try_files {path} /index.html
        file_server
    }
}
