# Secrets
WEBHOOK_SECRET=change-me
GHL_TOKEN=change-me
OPENAI_API_KEY=

# Core
DB_PATH=/data/sentinel.db
DATABASE_URL=
TIMEZONE=America/Chicago
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=17:00

# Skimmer live API (used by Route Rollover feature)
SKIMMER_API_BASE_URL=https://publicapi.getskimmer.com
SKIMMER_API_KEY=
# JSON object mapping GHL contact IDs to Skimmer tech IDs
# e.g. {"ghl_contact_abc123": "skimmer_tech_xyz"}
SKIMMER_TECH_ID_MAP={}

# Route Rollover feature toggle (1=enabled, 0=disabled)
ROLLOVER_ENABLED=1

# Skimmer nightly dump sync
# Legacy/manual fallback inputs for the older link-based flow.
SKIMMER_GDRIVE_FILE_ID=
SKIMMER_GDRIVE_FILE_URL=
SKIMMER_LINK_FILE=/data/skimmer/skimmer_link.txt
SKIMMER_DOWNLOAD_DIR=/data/skimmer
SKIMMER_DB_PATH=/data/skimmer/skimmer.db
SKIMMER_ARCHIVE_DIR=/data/skimmer/archive
SKIMMER_KEEP_DAILY=1
SKIMMER_IMPORT_TABLES=all
# Primary scheduled path: nightly Drive download, then trigger ingest-worker.
CRON_SKIMMER_SYNC_MINUTE=15
CRON_SKIMMER_SYNC_HOUR=11
CRON_SKIMMER_SYNC_DOW=*

# Ingest worker
INGEST_SOURCE_SYSTEM=skimmer
INGEST_FATAL_DROP_RATIO=0.50
INGEST_PIPELINE_LOCK_KEY=241103
INGEST_SKIP_DUPLICATE_SOURCE_SUCCESS=1
INACTIVE_PRUNE_DAYS=60
MONTHLY_CHEMICAL_COST_REVIEW_THRESHOLD=25
INGEST_TRIGGER_ENABLED=1
INGEST_TRIGGER_TIMEOUT_SECONDS=600
INGEST_WORKER_BASE_URL=http://ingest-worker:8010
# Leave blank to reuse WEBHOOK_SECRET for internal worker auth.
INGEST_WORKER_SECRET=
# Optional fallback cron inside ingest-worker. Leave blank to auto-derive
# a secondary schedule shortly after the Skimmer sync window.
CRON_INGEST_WORKER_MINUTE=
CRON_INGEST_WORKER_HOUR=
CRON_INGEST_WORKER_DOW=*

# GHL / LeadConnector
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_VERSION=2021-07-28
GHL_LOCATION_ID=
GHL_APP_BASE=https://app.gohighlevel.com
OPENAI_BASE_URL=https://api.openai.com/v1

# Routing / Access (comma-separated IDs)
MANAGER_CONTACT_IDS=
INTERNAL_CONTACT_IDS=
INTERNAL_USER_IDS=

# Behavior
FLOW_LOG_ENABLED=1
RAW_EVENTS_RETENTION_DAYS=30
INTERNAL_REPLY_GRACE_HOURS=12
ACK_CLOSE_ENABLED=1
ACK_CLOSE_WINDOW_MODE=eod
ACK_CLOSE_WINDOW_HOURS=12
ACK_CLOSE_MAX_LEN=80
ACK_CLOSE_IGNORE_WINDOW_FOR_PURE_ACK=1
SUMMARY_MAX_ITEMS_PER_SECTION=8
SMS_SLA_HOURS=0.5
CALL_SLA_HOURS=0.5
CALL_DEDUPE_WINDOW_MINUTES=240
CALL_RESOLVE_LOOKBACK_MINUTES=15
CALL_REQUIRE_MISSED_MARKER=1
CALL_MISSED_MARKER_KEYS=sentinel_missed_call,missed_call,is_missed_call
AI_GATE_ENABLED=0
AI_GATE_MODEL=gpt-5-mini
AI_GATE_SUPPRESS_NO_CONFIDENCE=0.90
AI_GATE_MAX_MESSAGES=10
AI_GATE_GAP_HOURS=4
AI_GATE_MAX_ISSUES_PER_RUN=20
AI_GATE_RUN_BUDGET_SECONDS=20
AI_GATE_TIMEOUT_SECONDS=4
AI_GATE_REDACT_PII=1
AI_GATE_ON_EVERY_INBOUND=0
AI_GATE_ON_EVERY_INBOUND_NO_CONFIDENCE=0.80
AI_GATE_MAX_OUTPUT_TOKENS=220
DECISION_MODE=deterministic
AI_PRIMARY_SUPPRESS_NO_CONFIDENCE=0.65

# Cron Scheduling
CRON_DOW=1-6
CRON_MORNING_HOUR=8
CRON_MIDDAY_HOUR=11
CRON_AFTERNOON_HOUR=15
CRON_BUSINESS_HOURS=8-16
CRON_BUSINESS_END_HOUR=17
CRON_ESCALATIONS_EVERY_MINUTES=1
CRON_POLL_RESOLVER_EVERY_MINUTES=15
CRON_VERIFY_PENDING_EVERY_MINUTES=5
