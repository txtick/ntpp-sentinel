{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "uvicorn": {
      "()": "logging.Formatter",
      "format": "%(asctime)s [%(levelname)-8s] uvicorn: %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(asctime)s [%(levelname)-8s] access: %(client_addr)s \"%(request_line)s\" %(status_code)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "app": {
      "()": "logging.Formatter",
      "format": "%(asctime)s [%(levelname)-8s] %(name)s: %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "uvicorn": {
      "formatter": "uvicorn",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr"
    },
    "access": {
      "formatter": "access",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    },
    "app": {
      "formatter": "app",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["uvicorn"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["uvicorn"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["access"],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["app"],
    "level": "INFO"
  }
}
